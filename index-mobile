<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Juliette Le Meudec - Portfolio</title>
    <style>
        /* Google fonts */
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=Crimson+Text:wght@300;400;600&display=swap');

        /* GLOBAL */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; }
        body {
            font-family: 'Crimson Text', serif;
            color: #2c2c2c;
            background: #fafafa;
            overflow-x: hidden; /* allow vertical scroll */
            -webkit-font-smoothing:antialiased;
            -moz-osx-font-smoothing:grayscale;
        }
        a { color: inherit; }

        /* make media elements responsive */
        img, iframe, video { max-width: 100%; height: auto; display: block; }

        /* Animated Watercolor Background (kept but subtle) */
        .watercolor-bg {
            position: fixed; inset: 0;
            z-index: -2;
            background: linear-gradient(45deg, #4a90a4, #5aa469, #b8860b, #cd853f, #9370db);
            background-size: 400% 400%;
            animation: aquarelleFlow 20s ease-in-out infinite;
            opacity: 0.95;
            filter: saturate(0.95) blur(0.6px);
        }
        @keyframes aquarelleFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Subtle vintage overlay */
        .vintage-overlay {
            position: fixed; inset: 0; z-index: -1; pointer-events: none;
            background-image:
                radial-gradient(circle at 25% 25%, rgba(139,69,19,0.02) 0%, transparent 50%),
                radial-gradient(circle at 75% 75%, rgba(160,82,45,0.02) 0%, transparent 50%);
            mix-blend-mode: multiply;
        }

        /* RIVER path (decorative). On small screens we'll stop animations and make it static */
        .river-path { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
        .river-flow {
            position: absolute;
            width: 8px; height: 8px;
            background: rgba(255,255,255,0.45);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(255,255,255,0.2);
            animation: riverFlow 15s linear infinite;
            opacity: 0.9;
        }
        .river-flow:nth-child(2) { animation-delay: -3s; }
        .river-flow:nth-child(3) { animation-delay: -6s; }
        .river-flow:nth-child(4) { animation-delay: -9s; }
        .river-flow:nth-child(5) { animation-delay: -12s; }

        @keyframes riverFlow {
            0% { left: 10%; top: 15%; opacity: 0; transform: scale(0.8); }
            10% { opacity: 1; }
            25% { left: 85%; top: 20%; transform: scale(1.2); }
            50% { left: 90%; top: 75%; transform: scale(0.8); }
            75% { left: 15%; top: 80%; transform: scale(1); }
            95% { opacity: 1; }
            100% { left: 10%; top: 15%; opacity: 0; transform: scale(0.8); }
        }

        /* Main container */
        .container {
            position: relative;
            min-height: 100vh;
            padding: 3rem 6rem;
            z-index: 2;
        }

        /* Portfolio sections (desktop: absolute floating bubbles; mobile: stacked) */
        .portfolio-section {
            position: absolute;
            background: rgba(255,255,255,0.78);
            padding: 2rem;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.28);
            transition: transform 0.35s ease, box-shadow 0.35s ease;
            cursor: pointer;
            min-width: 280px;
            max-width: 350px;
        }
        .portfolio-section:hover { transform: translateY(-10px) scale(1.03); box-shadow: 0 20px 60px rgba(0,0,0,0.18); }

        /* header bubble */
        .header-section { top: 5%; left: 45%; text-align: center; max-width: 520px; position: absolute; }
        .header-section h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem; color: #2c2c2c; margin-bottom: 0.25rem;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.06);
        }
        .header-section .subtitle { font-size: 1.1rem; color: #666; font-weight: 300; font-style: italic; }

        /* other bubbles positions */
        .about-section { top: 15%; right: 3%; animation: floatRight 8s ease-in-out infinite; }
        .projects-section { top: 40%; right: 15%; animation: floatBottomRight 10s ease-in-out infinite; }
        .teaching-section { top: 35%; left: 2%; animation: floatLeft 12s ease-in-out infinite; }
        .experience-section { top: 60%; left: 8%; transform: translateX(-50%); text-align:center; animation: floatLeft 6s ease-in-out infinite; }
        .contact-section { top: 65%; left: 40%; transform: translateX(-50%); text-align:center; animation: floatCenter 9s ease-in-out infinite; }

        /* animations for bubbles (desktop only) */
        @keyframes floatRight { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-12px) } }
        @keyframes floatBottomRight { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-18px) } }
        @keyframes floatLeft { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-10px) } }
        @keyframes floatCenter { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-12px) } }

        /* inside cards and grids */
        .projects-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1rem; }
        .projects-inside-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1rem; }
        .project-card {
            background: rgba(255,255,255,0.42);
            padding: 1rem; border-radius: 10px;
            border: 1px solid rgba(74,144,164,0.2);
            cursor: pointer; transition: transform .2s ease, box-shadow .2s ease;
        }
        .project-card:hover { transform: scale(1.02); box-shadow: 0 10px 30px rgba(0,0,0,0.12); }

        .portfolio-section h2 { font-family: 'Playfair Display', serif; font-size: 1.6rem; margin-bottom: .75rem; color: #2c2c2c; border-bottom: 2px solid rgba(74,144,164,0.25); padding-bottom: .5rem; }

        .contact-links { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin-top:1rem; }
        .contact-links a {
            display:inline-block; padding:.5rem 1rem; border-radius:20px; font-weight:600; text-decoration:none;
            border:2px solid transparent; transition: all .25s ease; color:#4a90a4;
        }
        .contact-links a:hover { background: rgba(74,144,164,0.08); color:#1f1f1f; border-color:#4a90a4; }

        /* Modal base */
        .modal { display:none; position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,0.6); backdrop-filter: blur(6px); justify-content:center; align-items:center; padding: 1rem; }
        .modal.active { display:flex; }
        .modal-content {
            background: rgba(255,255,255,0.96); border-radius: 18px; padding: 2.2rem; width: min(1100px, 96%); max-height: 90vh; overflow-y: auto; position: relative;
            box-shadow: 0 20px 60px rgba(0,0,0,0.28);
        }
        .modal-close { position:absolute; top:12px; right:12px; border:none; background:none; font-size:1.8rem; cursor:pointer; color:#666; }

        /* carousel inside modal */
        .carousel-container { position:relative; max-width:100%; margin: 1rem 0; text-align:center; }
        .carousel-image { width:100%; height:auto; border-radius:12px; object-fit:cover; }
        .carousel-nav {
            position:absolute; top:50%; transform:translateY(-50%); border:none; background: rgba(255,255,255,0.12); color: #fff; font-size:1.8rem; width:56px; height:56px; border-radius:50%; cursor:pointer;
            display:flex; align-items:center; justify-content:center;
        }
        .carousel-nav.prev { left: -70px; }
        .carousel-nav.next { right: -70px; }
        .close-btn { position:absolute; top:-50px; right:0; background:none; border:none; color:white; font-size:2rem; cursor:pointer; }

        .image-counter, .image-caption { color:white; }

        /* make project-specific backgrounds readable (kept styles) */
        .project-modal-content-treeam, .project-modal-content-vr, .project-modal-content-submersion,
        .project-modal-content-artgame, .project-modal-content-butterfly, .project-modal-content-escapeGame {
            position: relative; overflow: visible;
        }

        /* Submersion layout example elements */
        #submersionBoxes { display:flex; gap: 1rem; align-items: flex-start; width:100%; }
        #submersionText { flex: 1 1 40%; min-width: 200px; }
        #submersionImage { flex: 1 1 55%; min-width: 200px; display:grid; gap: .5rem; }

        /* small utilities */
        .clickable-poster { cursor:pointer; display:block; transition:transform .18s ease; }
        .clickable-poster:hover { transform:scale(1.03); }

        /* === RESPONSIVE / MOBILE STACKED LAYOUT === */
        @media (max-width: 1024px) {
            /* switch to stacked flow */
            .container { padding: 1.2rem; }
            .portfolio-section {
                position: relative !important;
                margin-bottom: 1rem;
                min-width: auto;
                max-width: 100%;
                transform: none !important;
                left: auto; right: auto; top: auto;
                animation: none !important;
            }

            /* hide heavy animations on mobile: river static (no animation) */
            .river-flow { animation: none !important; opacity: 0.6; box-shadow: none; }

            /* adjust header sizes */
            .header-section h1 { font-size: 2rem; text-align: center; }
            .header-section .subtitle { font-size: 1rem; text-align:center; }

            .projects-inside-grid { grid-template-columns: 1fr; }
            .modal-content { padding: 1rem; width: 100%; max-height: 92vh; border-radius: 12px; }
            .carousel-nav.prev { left: 8px; }
            .carousel-nav.next { right: 8px; }
            .carousel-nav { width:48px; height:48px; font-size:1.2rem; }
            .carousel-image { height: auto; max-height: 60vh; object-fit:contain; border-radius:10px; }
            #submersionBoxes { flex-direction: column; }
            #submersionText, #submersionImage { width: 100%; }
            .projects-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 480px) {
            .header-section h1 { font-size: 1.6rem; }
            .portfolio-section { padding: 1rem; border-radius: 12px; }
            .portfolio-section h2 { font-size: 1.25rem; }
        }

        /* small aesthetic tweaks when modal uses colored backgrounds - ensure text remains readable */
        .modal-content * { color: #222; line-height: 1.6; }
    </style>
</head>
