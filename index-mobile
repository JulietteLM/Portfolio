    <!-- SCRIPT: modals + carousel behaviour -->
    <script>
        // Basic modal open/close
        function openModal(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.add('active');
            el.setAttribute('aria-hidden', 'false');
            // lock scroll
            document.body.style.overflow = 'hidden';
        }
        function closeModal(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('active');
            el.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        // project-specific modal opener
        function openProjectModal(id) {
            // ensure parent projects modal is closed to avoid stacking issues on mobile
            closeModal('projectsModal');
            openModal(id);
        }

        // Carousel (gallery) logic
        const gallery = {
            images: [
                // fill these with your images or keep placeholders
                { src: 'gallery-1.jpg', caption: 'Gallery image 1' },
                { src: 'gallery-2.jpg', caption: 'Gallery image 2' },
                { src: 'gallery-3.jpg', caption: 'Gallery image 3' },
                { src: 'gallery-4.jpg', caption: 'Gallery image 4' },
                { src: 'gallery-5.jpg', caption: 'Gallery image 5' }
            ],
            idx: 0
        };

        function openCarousel(index = 0) {
            if (!gallery.images.length) return;
            gallery.idx = index || 0;
            updateCarousel();
            openModal('carouselModal');
            // set focus for accessibility
            const img = document.getElementById('carouselImage');
            if (img) img.focus();
        }
        function closeCarousel() {
            closeModal('carouselModal');
        }
        function updateCarousel() {
            const imgEl = document.getElementById('carouselImage');
            const cap = document.getElementById('carouselCaption');
            const cur = document.getElementById('currentImage');
            const tot = document.getElementById('totalImages');
            if (!imgEl || !cap || !cur || !tot) return;
            const item = gallery.images[gallery.idx];
            imgEl.src = item.src;
            imgEl.alt = item.caption || ('Gallery image ' + (gallery.idx + 1));
            cap.textContent = item.caption || '';
            cur.textContent = gallery.idx + 1;
            tot.textContent = gallery.images.length;
        }
        function prevImage() {
            if (!gallery.images.length) return;
            gallery.idx = (gallery.idx - 1 + gallery.images.length) % gallery.images.length;
            updateCarousel();
        }
        function nextImage() {
            if (!gallery.images.length) return;
            gallery.idx = (gallery.idx + 1) % gallery.images.length;
            updateCarousel();
        }

        // close modal on Escape key
        document.addEventListener('keydown', function(e){
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.active').forEach(m => {
                    m.classList.remove('active');
                    m.setAttribute('aria-hidden','true');
                });
                document.body.style.overflow = '';
            }
            // left / right arrows for carousel
            if (e.key === 'ArrowLeft') prevImage();
            if (e.key === 'ArrowRight') nextImage();
        });

        // Accessibility: open modals on Enter or Space when section is focused
        document.querySelectorAll('.portfolio-section[role="button"]').forEach(el=>{
            el.addEventListener('keydown', (ev)=>{
                if (ev.key === 'Enter' || ev.key === ' ') {
                    ev.preventDefault();
                    el.click();
                }
            });
        });

        // Optional: prevent click inside modal content from closing (if you later add an overlay click close)
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', function(e){
                if (e.target === modal) {
                    // clicking on overlay closes modal
                    modal.classList.remove('active');
                    modal.setAttribute('aria-hidden','true');
                    document.body.style.overflow = '';
                }
            });
        });

        // On load, if you want to disable heavy backgrounds on low-power devices you could detect here (not implemented)
        // Example: detect small screens and stop heavy animation by applying an attribute/class

        // If you want the river completely hidden on very small screens, uncomment:
        // if (window.matchMedia('(max-width:640px)').matches) document.querySelector('.river-path').style.display = 'none';
    </script>
